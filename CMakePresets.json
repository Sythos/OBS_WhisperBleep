{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "vendor": {
    "Sythos": {
      "SPDX-License-Identifier": "MIT",
      "SPDX-FileCopyrightText": "2026 Sythos (www.sythos.net)"
    }
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "OBS WhisperBleep Debug",
      "description": "Portable M5 build with backend, timeline and asset tests",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OBS_WHISPERBLEEP_BUILD_TESTS": "ON",
        "OBS_WHISPERBLEEP_BUILD_PLUGIN_STUB": "ON",
        "WHISPER_RUNTIME": "stub"
      }
    },
    {
      "name": "release",
      "displayName": "OBS WhisperBleep Release",
      "description": "Portable M5 build prepared for packaging",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OBS_WHISPERBLEEP_BUILD_TESTS": "ON",
        "OBS_WHISPERBLEEP_BUILD_PLUGIN_STUB": "ON",
        "WHISPER_RUNTIME": "stub"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
