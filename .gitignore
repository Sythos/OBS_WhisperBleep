# ---------------------------------------------------------------------------
# Generic repository-wide ignore rules for source code, development tools,
# editor state, build products, caches, and downloaded artifacts.
# ---------------------------------------------------------------------------
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: 2026 Sythos (https://www.sythos.net/)

# Editor and local workspace state ------------------------------------------
.local/
.local-workspace/
.vscode/
.idea/
*.local
*.local.*
*_INSTRUCTIONS.md
*.swp
*.swo
*~

# Local scratch and temporary data ------------------------------------------
scratch/
sandbox/
tmp/
temp/
*.tmp
*.bak

# Language and tool caches --------------------------------------------------
.cache/
.npm/
.pytest_cache/
__pycache__/
*.pyc
node_modules/
*.tsbuildinfo
coverage/
.nyc_output/

# Build configuration and generated output ---------------------------------
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt
compile_commands.json
dist/
artifacts/
packages/

# Compiled objects and local binaries ---------------------------------------
*.obj
*.o
*.a
*.lib
*.dll
*.dylib
*.so
*.exe
*.pdb

# Model weights and runtime caches ------------------------------------------
model-cache/
models/
weights/
*.bin
*.gguf
*.onnx
*.pt
*.pth
*.safetensors

# Operating-system metadata -------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
